FROM faissdb:build

# faissdb:build already provides: Ubuntu base + build tools, goenv with the
# Go version pinned by server/.go-version, RocksDB, FAISS, protoc, the
# faissdb server binary, and /etc/profile set up to initialize goenv for
# login shells. This image adds only what CI needs on top:
#   - /usr/local/.faissdb convenience file (goenv/nodenv init helper)
#   - nodenv + Node.js 22.14.0 for the mocha client tests

COPY mnt/.faissdb /usr/local/.faissdb

RUN git clone https://github.com/nodenv/nodenv.git /usr/local/nodenv \
 && git clone https://github.com/nodenv/node-build.git /usr/local/nodenv/plugins/node-build \
 && export NODENV_ROOT=/usr/local/nodenv \
 && export PATH="$NODENV_ROOT/bin:$PATH" \
 && eval "$(nodenv init -)" \
 && nodenv install 22.14.0 \
 && nodenv global 22.14.0

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
